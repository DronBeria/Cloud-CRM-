APP_NAME="Cloud CRM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.onrender.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ── Database ──────────────────────────────────────────────────────────────────
# Render provides a DATABASE_URL for PostgreSQL — set DB_CONNECTION=pgsql
# and paste your Render Internal Database URL into DATABASE_URL, OR fill in
# the individual fields below.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=paymenter
DB_USERNAME=paymenter
DB_PASSWORD=

# Alternatively, use a single DATABASE_URL (Render PostgreSQL):
# DATABASE_URL=postgresql://user:password@host:5432/database

# ── Session / Cache / Queue ───────────────────────────────────────────────────
# Use 'database' driver for single-server Render deployments.
# Switch to 'redis' if you add a Redis instance.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── Mail ──────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Payment Gateways ──────────────────────────────────────────────────────────
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX=false

MOLLIE_KEY=

# ── Social Auth (optional) ────────────────────────────────────────────────────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI="${APP_URL}/oauth/discord/callback"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/oauth/google/callback"

# ── Google Drive Backup Extension ─────────────────────────────────────────────
# (also set in the Admin panel → Extensions → Google Drive Backup settings)
GDRIVE_GOOGLE_CLIENT_ID=
GDRIVE_GOOGLE_CLIENT_SECRET=

# ── Telemetry (optional, set false to disable) ────────────────────────────────
TELEMETRY_ENABLED=false

# ── AWS S3 (optional — for file storage if not using local disk) ──────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Redis (optional — for cache/session/queue if you add Render Redis) ────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Vite ──────────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
