# CoCloud TSplus Agent Configuration
# Copy this to .env and fill in your values

# Secret key — must match TSPLUS_AGENT_KEY in your Vercel environment variables
AGENT_API_KEY=change-this-to-a-long-random-secret

# Port the agent listens on (open this in Windows Firewall)
PORT=7820

# Base path for all client Tally installations
TALLY_BASE_PATH=D:\TallyClients

# Your TSplus server public URL (used to generate launch links)
TSPLUS_SERVER_URL=https://rdp.yourdomain.com
